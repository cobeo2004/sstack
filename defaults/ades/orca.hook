#!/usr/bin/env python3
"""Orca adapter hook (docs/spec/ade.md). delegate: `orca orchestration worker-start` (it creates the
Run and Task); wait: `worker-show` until the worker settles; collect: the report the worker wrote;
cancel: `worker-stop`. Checked against Orca's live CLI (worker-start/worker-show/worker-stop) and
tests/fakes/orca. State ($SSTACK_HOOK_STATE): report = the member's report path.
Every child runs in this checkout (`--worktree current`): sstack treats a hook child like a shell
child, under the checkout's write lock, and gates and reviews the edits here."""
import json, os, shutil, subprocess, sys
from pathlib import Path

cap, d = sys.argv[1], json.loads(sys.stdin.read() or "{}")
state = Path(os.environ.get("SSTACK_HOOK_STATE", "."))
# `--environment local`: this machine's Orca, whatever ORCA_ENVIRONMENT or a pairing code selects
# shutil.which: Windows' CreateProcess skips PATHEXT, so a bare "orca" misses orca.cmd
orca = lambda cmd, *a, **kw: subprocess.run([shutil.which("orca") or "orca", "orchestration", cmd, "--environment", "local", *a],
                                            capture_output=True, text=True, **kw)


def result(r) -> dict:
    try:
        out = json.loads(r.stdout)
    except ValueError:
        return {}
    return out.get("result") or {} if isinstance(out, dict) and out.get("ok") else {}


if cap == "detect":
    sys.exit(0 if os.environ.get("ORCA_AGENT_SESSION_ID") else 1)
if cap == "delegate":
    if not shutil.which("orca"):
        print(json.dumps({"action": "none", "note": "orca CLI not on PATH; running headless"}))
        sys.exit(0)
    agent, _, model = d["member"].partition("/")
    task = (f"Read the brief at {d['brief']} and do exactly what it says. Write your report to {d['report']}. "
            "If you cannot write files, return the full report as your final message.")  # = sstack_ade.TASK
    # `--opt=value`: a user title starting with "-" stays a value, never a flag
    r = orca("worker-start", "--spec", task, f"--task-title={d['title']}", "--worktree", "current",
             "--agent", agent, *(["--model", model] if model and model != "default" else []), "--json")
    job = result(r).get("dispatchId")
    if r.returncode != 0 or not job:
        sys.stderr.write(r.stderr or r.stdout)
        sys.exit(1)
    (state / "report").write_text(d["report"])
    print(json.dumps({"action": "async", "id": job}))
elif cap == "wait":
    r = orca("worker-show", "--dispatch", d["id"], "--json")
    w = result(r)
    if not w:  # runtime busy or restarting: poll again; [dispatch] timeout_min bounds it
        sys.exit(10)
    if w.get("stage") == "settled":
        sys.exit(0 if w.get("state") == "succeeded" else 1)
    sys.exit(1 if w.get("liveness") in ("exited", "lost") else 10)
elif cap == "collect":
    p = Path((state / "report").read_text()) if (state / "report").is_file() else None
    text = p.read_text() if p and p.is_file() else ""
    sys.stdout.write(text)
    sys.exit(0 if text else 1)
elif cap == "cancel":
    orca("worker-stop", "--dispatch", d["id"])
else:
    sys.exit(1)
