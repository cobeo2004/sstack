#!/usr/bin/env python3
"""Publish before/after screenshots, diagrams and recordings for a PR to a separate
media branch (never the PR's own branch), then print a marked Before | After section.

  sstack-pr-media <pr> <file>... [--repo owner/name] [--branch sstack-media] [--dry-run] [--edit-body]

Name files before-<step>.<ext> / after-<step>.<ext>; matching steps share one HTML
table row, with images and Mermaid diagrams side by side. Videos get an inline GIF
copy when ffmpeg is installed (GitHub won't play repo videos inline). Mermaid files
(.mmd, e.g. before-<flow>.mmd / after-<flow>.mmd for backend changes) are inlined as
```mermaid blocks, which GitHub renders; they are never pushed.

--edit-body puts the marked section in the PR description, replacing an earlier
sstack-media section or appending it when there is none.
"""
import argparse
import html
import re
import shutil
import subprocess
import sys
import tempfile
from urllib.parse import quote
from pathlib import Path

IMAGES = {".png", ".jpg", ".jpeg", ".gif", ".webp"}
VIDEOS = {".mp4", ".mov", ".webm"}
MEDIA_START = "<!-- sstack-media -->"
MEDIA_END = "<!-- /sstack-media -->"


def git(*args, cwd=None, check=True):
    return subprocess.run(["git", *args], cwd=cwd, check=check, capture_output=True, text=True)


def repo_slug() -> str:
    url = git("remote", "get-url", "origin").stdout.strip()
    m = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?/?$", url)
    if not m:
        sys.exit(f"sstack-pr-media: can't read owner/repo from origin {url!r}; pass --repo owner/name")
    return m.group(1)


def gif_of(video: Path) -> Path | None:
    if not shutil.which("ffmpeg"):
        return None
    out = video.with_suffix(".gif")
    r = subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", str(video),
                        "-vf", "fps=10,scale=720:-1:flags=lanczos", str(out)])
    return out if r.returncode == 0 else None


def table(base: str, names: list[str], diagrams: dict[str, str] | None = None) -> str:
    link = lambda n: f"{base}{quote(n)}?raw=true"
    rows: dict[str, dict[str, str]] = {}
    videos, other = [], []
    for n in names:
        ext = Path(n).suffix.lower()
        m = re.match(r"(before|after)-(.+)\.\w+$", n)
        if ext in VIDEOS:
            videos.append(f"[{n}]({link(n)})")
        elif m and ext in IMAGES:
            rows.setdefault(m.group(2), {})[m.group(1)] = f'<img src="{link(n)}" alt="{html.escape(n)}">'
        else:
            other.append(f"[{n}]({link(n)})")
    for n, text in (diagrams or {}).items():
        m = re.match(r"(before|after)-(.+)\.mmd$", n)
        side, key = (m.group(1), m.group(2)) if m else ("after", Path(n).stem)
        rows.setdefault(key, {})[side] = (
            f"\n\n```mermaid\n{text.rstrip(chr(10))}\n```\n\n"
        )
    out = [MEDIA_START, "### Before / after", ""]
    if rows:
        out += ["<table>", "<tr><th>Before</th><th>After</th></tr>"]
        for step in sorted(rows):
            out += [
                f'<tr><td colspan="2"><b>{html.escape(step)}</b></td></tr>',
                f'<tr><td>{rows[step].get("before", "—")}</td><td>{rows[step].get("after", "—")}</td></tr>',
            ]
        out += ["</table>"]
    if videos:
        out += ["", "Recordings: " + " · ".join(videos)]
    if other:
        out += ["", "Other: " + " · ".join(other)]
    out += ["", MEDIA_END]
    return "\n".join(out) + "\n"


def replace_section(body: str, section: str) -> str:
    # pair the first end marker with the nearest start before it: a stray start never eats user text
    end = body.find(MEDIA_END)
    start = body.rfind(MEDIA_START, 0, end) if end != -1 else -1
    if start != -1 and end != -1:
        return body[:start] + section + body[end + len(MEDIA_END):]
    body = body.rstrip()
    return f"{body}\n\n{section}" if body else section


def edit_pr_body(pr: str, repo: str | None, section: str) -> None:
    repo_args = ["-R", repo] if repo else []
    view = ["gh", "pr", "view", pr, *repo_args, "--json", "body", "-q", ".body"]
    try:
        current = subprocess.run(view, capture_output=True, text=True)
    except OSError as e:
        sys.exit(f"sstack-pr-media: {e}\n\n{section}")
    if current.returncode:
        sys.exit(f"sstack-pr-media: gh pr view failed: {current.stderr.strip()}\n\n{section}")
    body = replace_section(current.stdout, section)
    edit = ["gh", "pr", "edit", pr, *repo_args, "--body-file", "-"]
    try:
        result = subprocess.run(edit, input=body, capture_output=True, text=True)
    except OSError as e:
        sys.exit(f"sstack-pr-media: {e}\n\n{section}")
    if result.returncode:
        sys.exit(f"sstack-pr-media: gh pr edit failed: {result.stderr.strip()}\n\n{section}")


def main() -> int:
    ap = argparse.ArgumentParser(prog="sstack-pr-media")
    ap.add_argument("pr")
    ap.add_argument("files", nargs="+", type=Path)
    ap.add_argument("--repo")
    ap.add_argument("--branch", default="sstack-media")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--edit-body", action="store_true",
                    help="replace the marked section in the PR description instead of printing only")
    a = ap.parse_args()
    missing = [str(f) for f in a.files if not f.is_file()]
    if missing:
        sys.exit(f"sstack-pr-media: no such file: {', '.join(missing)}")
    diagrams = {f.name: f.read_text() for f in a.files if f.suffix.lower() == ".mmd"}
    files = [f for f in a.files if f.suffix.lower() != ".mmd"]
    for f in list(files):
        if f.suffix.lower() in VIDEOS and (g := gif_of(f)):
            files.append(g)
    names = sorted(dict.fromkeys(f.name for f in files))
    dest = f"pr-{a.pr}"
    base = f"https://github.com/{a.repo or repo_slug()}/blob/{a.branch}/{dest}/"
    if a.dry_run:
        print(f"would push {len(names)} files to origin/{a.branch}:{dest}/\n")
        sys.stdout.write(table(base, names, diagrams))
        return 0
    if not files:  # diagrams only: nothing to host
        section = table(base, names, diagrams)
        if a.edit_body:
            edit_pr_body(a.pr, a.repo, section)
        sys.stdout.write(section)
        return 0
    tmp = Path(tempfile.mkdtemp(prefix="sstack-media-"))
    try:
        if git("ls-remote", "--heads", "origin", a.branch).stdout.strip():
            git("fetch", "-q", "origin", a.branch)
            git("worktree", "add", "-q", "--detach", str(tmp), "FETCH_HEAD")
        else:  # first publish: an orphan branch that shares no history with the code
            git("worktree", "add", "-q", "--detach", str(tmp), "HEAD")
            git("checkout", "-q", "--orphan", a.branch, cwd=tmp)
            git("rm", "-rfq", ".", cwd=tmp, check=False)
            git("clean", "-fdxq", cwd=tmp)
        (tmp / dest).mkdir(parents=True, exist_ok=True)
        for f in files:
            shutil.copy(f, tmp / dest / f.name)
        git("add", dest, cwd=tmp)
        git("commit", "-qm", f"media: {dest}", cwd=tmp)
        git("push", "-q", "origin", f"HEAD:refs/heads/{a.branch}", cwd=tmp)
    except subprocess.CalledProcessError as e:
        sys.exit(f"sstack-pr-media: {' '.join(e.cmd[:3])} failed: {e.stderr.strip()}")
    finally:
        git("worktree", "remove", "--force", str(tmp), check=False)
        shutil.rmtree(tmp, ignore_errors=True)
    section = table(base, names, diagrams)
    if a.edit_body:
        edit_pr_body(a.pr, a.repo, section)
    sys.stdout.write(section)
    return 0


if __name__ == "__main__":
    sys.exit(main())
