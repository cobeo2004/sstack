#!/usr/bin/env python3
"""End-of-session hook: if [reflect] auto = true, run a background reflect pass
(role scout) over the transcript and record its LESSON lines as pending."""
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO / "lib"))
import sstack_dispatch  # noqa: E402
import sstack_lessons  # noqa: E402
from sstack_config import ConfigError, git_root, load  # noqa: E402

LESSON = re.compile(r"^\s*LESSON:\s*(repo|global)\s*\|\s*(.+?)\s*\|\s*(.+?)\s*$")
PANEL_OK = re.compile(r": exit 0 → (.+)$", re.M)  # sstack_dispatch's panel index line


def capture_brief() -> str:
    text = (REPO / "skills" / "reflect" / "SKILL.md").read_text()
    m = re.search(r"^## Capture brief\n(.*?)(?=^## |^---$)", text, re.S | re.M)
    return m.group(1).strip()


def run(payload: dict) -> int:
    cwd = Path(payload.get("cwd") or os.getcwd())
    root = git_root(cwd)
    try:
        cfg = load(root)
    except ConfigError:
        return 0
    if os.environ.get("SSTACK_REFLECT") or not cfg.get("reflect", {}).get("auto") or root is None:
        return 0
    run_dir = root / ".sstack" / "runs" / f"reflect-{time.strftime('%Y%m%d-%H%M%S')}"
    run_dir.mkdir(parents=True, exist_ok=True)
    brief = run_dir / "scout.brief.md"
    brief.write_text(f"# reflect capture\n\n{capture_brief()}\n\nTranscript: {payload.get('transcript_path', '(none)')}\n")
    report = run_dir / "scout.report.md"
    os.environ["SSTACK_REFLECT"] = "1"  # the child's own session end must not reflect again
    os.chdir(root)
    code = sstack_dispatch.main(["scout", "--brief", str(brief), "--report", str(report), "--title", "sstack reflect"])
    if code != 0 or not report.exists():
        return 0
    # A panel's report is an index; only members it marks `exit 0` count (a failed member's
    # partial report stays on disk). The same lesson from two members is one lesson, compared
    # the way the store compares them.
    text = report.read_text()
    paths = ([Path(p) for p in PANEL_OK.findall(text)] if text.startswith("# scout panel") else [report])
    done: set[tuple[str, str]] = set()
    for path in paths:
        for line in path.read_text().splitlines():
            m = LESSON.match(line)
            key = m and (m.group(1), sstack_lessons._norm(m.group(2)))
            if not m or m.group(2).startswith("<") or key in done:
                continue
            done.add(key)
            sstack_lessons.add(sstack_lessons.lessons_path(m.group(1), root), m.group(2), m.group(3))
    return 0


def main() -> int:
    raw = sys.stdin.read()
    try:
        payload = json.loads(raw or "{}")
    except json.JSONDecodeError:
        return 0
    if "--foreground" in sys.argv:
        return run(payload)
    # quick exit in the hook process when disabled; otherwise detach and return at once
    if os.environ.get("SSTACK_REFLECT"):
        return 0
    p = subprocess.Popen([sys.executable, __file__, "--foreground"], stdin=subprocess.PIPE,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True, text=True)
    p.stdin.write(raw)
    p.stdin.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
