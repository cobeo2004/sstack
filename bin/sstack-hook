#!/usr/bin/env python3
"""One hook entry for every harness (docs/spec/hooks.md): normalize the harness's JSON payload,
then post-edit runs the repo's [project] check on each edited file, and session-end hands the
transcript to sstack-reflect-hook. Bad input never fails the agent's session."""
import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO / "lib"))
from sstack_config import ConfigError, git_root, load  # noqa: E402

HARNESSES = ("claude", "codex", "cursor", "pi")
PATCH_FILE = re.compile(r"^\*\*\* (?:Add File|Update File|Move to): (.+?)\s*$", re.M)
TIMEOUT = 120  # pi runs the hook synchronously, so a stuck check must not freeze it
BLOCKS = {"claude", "codex", "pi"}  # cursor's afterFileEdit output is not fed back to the agent


def normalize(harness: str, event: str, p: dict) -> dict:
    roots = p.get("workspace_roots") or [None]
    cwd = Path((roots[0] if harness == "cursor" else p.get("cwd")) or os.getcwd())
    transcript = p.get("session_file") if harness == "pi" else p.get("transcript_path")
    files: list[str] = []
    if event == "post-edit":
        tool = p.get("input" if harness == "pi" else "tool_input")
        tool = tool if isinstance(tool, dict) else p  # cursor puts file_path at the top level
        path = tool.get("path" if harness == "pi" else "file_path")
        if path:
            files = [path]
        elif harness == "codex" and isinstance(tool.get("command"), str):
            files = PATCH_FILE.findall(tool["command"])
    return {"harness": harness, "event": event, "cwd": str(cwd), "transcript": transcript or None,
            "files": [str(cwd / f) for f in files]}


def post_edit(n: dict) -> int:
    root = git_root(Path(n["cwd"]))
    if root is None:
        return 0
    try:
        check = (load(root).get("project") or {}).get("check")
    except ConfigError:
        return 0
    if not check:
        return 0
    failed = False
    for f in n["files"]:
        path = Path(f).resolve()
        if not path.is_file() or not path.is_relative_to(root):
            continue  # deleted, or not this repo's file
        rel = str(path.relative_to(root))
        cmd = check
        for q in ('"{path}"', "'{path}'", "{path}"):
            cmd = cmd.replace(q, '"$1"')  # the path arrives as $1, never as shell text
        try:
            r = subprocess.run(["sh", "-c", cmd, "sstack-hook", rel], cwd=root, capture_output=True,
                               text=True, timeout=TIMEOUT)
            out = "" if r.returncode == 0 else f"{r.stdout}{r.stderr}"
        except subprocess.TimeoutExpired:
            r, out = None, f"timed out after {TIMEOUT}s"
        if r is None or r.returncode != 0:
            failed = True
            print(f"sstack-hook: check failed: {rel}\n{out}".rstrip(), file=sys.stderr)
    return 2 if failed and n["harness"] in BLOCKS else 0


def session_end(n: dict, p: dict) -> int:
    if not n["transcript"]:
        print("reflect: skipped (no transcript)", file=sys.stderr)
        return 0
    payload = {"cwd": n["cwd"], "session_id": p.get("session_id") or n["transcript"],
               "transcript_path": n["transcript"]}
    subprocess.run([sys.executable, str(REPO / "bin" / "sstack-reflect-hook")], input=json.dumps(payload),
                   text=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)  # it detaches at once
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="sstack-hook")
    ap.add_argument("event", choices=("post-edit", "session-end"))
    ap.add_argument("--harness", required=True, choices=HARNESSES)
    ap.add_argument("--print-normalized", action="store_true", help="print the normalized payload, exit 0")
    a = ap.parse_args()
    try:
        p = json.loads(sys.stdin.read() or "{}")
    except json.JSONDecodeError:
        return 0
    if not isinstance(p, dict):
        return 0
    n = normalize(a.harness, a.event, p)
    if a.print_normalized:
        print(json.dumps(n))
        return 0
    return post_edit(n) if a.event == "post-edit" else session_end(n, p)


if __name__ == "__main__":
    sys.exit(main())
