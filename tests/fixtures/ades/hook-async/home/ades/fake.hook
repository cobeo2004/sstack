#!/bin/sh
# Async: delegate starts job-1; wait exits 10, 10, then 0; collect prints the report;
# cancel leaves a marker. State lives in $SSTACK_HOOK_STATE (dispatch sets it), never the cwd.
S="${SSTACK_HOOK_STATE:?}"
case "$1" in
  detect) exit 0 ;;
  delegate) cat >/dev/null; rm -f "$S/polls"; echo '{"action": "async", "id": "job-1"}' ;;
  wait) cat >/dev/null; n=$(cat "$S/polls" 2>/dev/null || echo 0); n=$((n + 1)); echo $n > "$S/polls"
        [ "$n" -ge 3 ] && exit 0; exit 10 ;;
  collect) cat >/dev/null; printf 'REPORT async\n' ;;
  cancel) cat >/dev/null; touch "$S/cancelled" ;;
  *) exit 1 ;;
esac
