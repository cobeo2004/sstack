{
  "ade": "auto",
  "dispatch": {
    "timeout_min": 30,
    "via": "headless"
  },
  "harness": {
    "claude": {
      "headless": [
        "claude",
        "-p",
        "--model",
        "{model}",
        "--permission-mode",
        "acceptEdits"
      ],
      "headless_readonly": [
        "claude",
        "-p",
        "--model",
        "{model}",
        "--permission-mode",
        "plan"
      ]
    },
    "codex": {
      "headless": [
        "codex",
        "exec",
        "--sandbox",
        "workspace-write",
        "-m",
        "{model}",
        "-c",
        "model_reasoning_effort={effort}",
        "-"
      ],
      "headless_readonly": [
        "codex",
        "exec",
        "--sandbox",
        "read-only",
        "-m",
        "{model}",
        "-c",
        "model_reasoning_effort={effort}",
        "-"
      ]
    },
    "cursor": {
      "headless": [
        "cursor-agent",
        "-p",
        "--force",
        "--model",
        "{model}"
      ],
      "headless_readonly": [
        "cursor-agent",
        "-p",
        "--trust",
        "--mode",
        "plan",
        "--model",
        "{model}"
      ]
    },
    "fake": {
      "headless": [
        "fake"
      ],
      "headless_readonly": [
        "fake",
        "--ro"
      ]
    },
    "pi": {
      "headless": [
        "pi",
        "-p",
        "--no-session",
        "--model",
        "{model}",
        "--thinking",
        "{effort}"
      ],
      "headless_readonly": [
        "pi",
        "-p",
        "--no-session",
        "--model",
        "{model}",
        "--thinking",
        "{effort}",
        "--tools",
        "read,grep,find,ls"
      ]
    }
  },
  "project": {
    "verify": [
      "make quick"
    ]
  },
  "reflect": {
    "auto": false,
    "encode_at": 2
  },
  "role": {
    "implement": {
      "effort": "high",
      "harness": "pi",
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "review": {
      "effort": "low",
      "harness": "fake",
      "model": "my-reviewer"
    },
    "scout": {
      "harness": "claude",
      "model": "haiku"
    }
  },
  "rules": {
    "auto_escalate": true,
    "loop_guard": 2,
    "max_parallel": 1,
    "panel_diff_lines": 400,
    "review_not_implementer": true,
    "tier_order": [
      "cheap",
      "standard",
      "strong"
    ]
  }
}
